# API base used in production. Leave blank to use localhost.
VITE_API_URL=http://localhost:3001

# PostgreSQL connection (do NOT commit real credentials)
# Option A: single connection string
# PG_CONNECTION_STRING=postgresql://user:password@host:5432/database

# Option B: individual values
PG_USER=postgres
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=EDUGR
